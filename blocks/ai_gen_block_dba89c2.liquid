{% doc %}
  @prompt
    Product Banner with Shop Button that has a dynamic limited time discount offer feature
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    position: relative;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-product-banner-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-product-banner-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}%;
    max-width: {{ block.settings.image_width }}%;
  }

  .ai-product-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-banner-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-product-banner-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-product-banner-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-product-banner-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_background_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    width: fit-content;
  }

  .ai-product-banner-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-banner-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-product-banner-discount-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-product-banner-discount-{{ ai_gen_id }} {
    font-size: {{ block.settings.discount_size }}px;
    font-weight: 700;
    color: {{ block.settings.discount_color }};
  }

  .ai-product-banner-timer-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .ai-product-banner-timer-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-product-banner-timer-display-{{ ai_gen_id }} {
    display: flex;
    gap: 6px;
  }

  .ai-product-banner-timer-unit-{{ ai_gen_id }} {
    background-color: {{ block.settings.timer_background_color }};
    color: {{ block.settings.timer_text_color }};
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    min-width: 32px;
    text-align: center;
  }

  .ai-product-banner-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    padding: 14px 32px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    width: fit-content;
  }

  .ai-product-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-product-banner-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 24px;
      padding: {{ block.settings.padding_vertical | times: 0.6 }}px {{ block.settings.padding_horizontal | times: 0.6 }}px;
    }

    .ai-product-banner-image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
    }

    .ai-product-banner-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-banner-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-product-banner-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<product-banner-{{ ai_gen_id }} class="ai-product-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-banner-container-{{ ai_gen_id }}">
    <div class="ai-product-banner-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.product_image %}
        <img
          src="{{ block.settings.product_image | image_url: width: 800 }}"
          alt="{{ block.settings.product_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.product_image.width }}"
          height="{{ block.settings.product_image.height }}"
          class="ai-product-banner-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-product-banner-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-product-banner-content-{{ ai_gen_id }}">
      {% if block.settings.show_badge %}
        <div class="ai-product-banner-badge-{{ ai_gen_id }}">
          {{ block.settings.badge_text }}
        </div>
      {% endif %}

      {% if block.settings.title != blank %}
        <h2 class="ai-product-banner-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-product-banner-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      <div class="ai-product-banner-discount-wrapper-{{ ai_gen_id }}">
        {% if block.settings.show_discount %}
          <div class="ai-product-banner-discount-{{ ai_gen_id }}">
            {{ block.settings.discount_text }}
          </div>
        {% endif %}

        {% if block.settings.show_timer %}
          <div class="ai-product-banner-timer-{{ ai_gen_id }}">
            <span class="ai-product-banner-timer-label-{{ ai_gen_id }}">{{ block.settings.timer_label }}</span>
            <div class="ai-product-banner-timer-display-{{ ai_gen_id }}" data-end-date="{{ block.settings.end_date }}" data-end-time="{{ block.settings.end_time }}">
              <span class="ai-product-banner-timer-unit-{{ ai_gen_id }}" data-unit="days">00</span>
              <span class="ai-product-banner-timer-unit-{{ ai_gen_id }}" data-unit="hours">00</span>
              <span class="ai-product-banner-timer-unit-{{ ai_gen_id }}" data-unit="minutes">00</span>
              <span class="ai-product-banner-timer-unit-{{ ai_gen_id }}" data-unit="seconds">00</span>
            </div>
          </div>
        {% endif %}
      </div>

      <a
        href="{{ block.settings.button_link }}"
        class="ai-product-banner-button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    </div>
  </div>
</product-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.timerDisplay = this.querySelector('.ai-product-banner-timer-display-{{ ai_gen_id }}');
        this.interval = null;
      }

      connectedCallback() {
        if (this.timerDisplay) {
          this.startCountdown();
        }
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      startCountdown() {
        const endDate = this.timerDisplay.getAttribute('data-end-date');
        const endTime = this.timerDisplay.getAttribute('data-end-time');

        if (!endDate || !endTime) {
          return;
        }

        const endDateTime = new Date(endDate + 'T' + endTime).getTime();

        this.updateTimer(endDateTime);

        this.interval = setInterval(() => {
          this.updateTimer(endDateTime);
        }, 1000);
      }

      updateTimer(endDateTime) {
        const now = new Date().getTime();
        const distance = endDateTime - now;

        if (distance < 0) {
          if (this.interval) {
            clearInterval(this.interval);
          }
          this.setTimerValues(0, 0, 0, 0);
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        this.setTimerValues(days, hours, minutes, seconds);
      }

      setTimerValues(days, hours, minutes, seconds) {
        const daysEl = this.timerDisplay.querySelector('[data-unit="days"]');
        const hoursEl = this.timerDisplay.querySelector('[data-unit="hours"]');
        const minutesEl = this.timerDisplay.querySelector('[data-unit="minutes"]');
        const secondsEl = this.timerDisplay.querySelector('[data-unit="seconds"]');

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
        if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
      }
    }

    customElements.define('product-banner-{{ ai_gen_id }}', ProductBanner{{ ai_gen_id }});
  })();
</script>

