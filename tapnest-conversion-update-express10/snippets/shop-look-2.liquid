{% comment %}
  Renders a shop-look-2

  Accepts:
  - product: {Object} Product (optional)
  - card_type: {String} Card type (optional)
  - placement: {string} Placement (optional)
  - shortcut_image: {Object} Image (optional)
  - shortcut_title: {String} Title (optional)
  - shortcut_description: {String} Description (optional)
  - shortcut_button_text: {String} Button text (optional)
  - shortcut_button_link: {String} Button link (optional)
  Usage:
  {% render 'shop-look-2' %}
{% endcomment %}

{% assign min = 10000 %}
{% assign max = 99999 %}
{% assign range = max | minus: min | plus: 1 %}
{% assign random_offset = 'now' | date: '%N' | modulo: range %}
{% assign random_number = min | plus: random_offset %}
{%- assign placeholder_image = 'collection-1' -%}
{% assign final_card_type = card_type | default: 'product' %}
{% assign final_shortcut_button_text = shortcut_button_text | default: 'Download' %}

<div class="shop-look-2">
  <xo-popover-trigger
    class="shop-look-2__trigger"
    xo-name="hotspot-{{ random_number }}"
    {% if type == 'hover' %}
      xo-type="hover"
    {% endif %}
    style="--color: {{ color }}"
    tabindex="0"
    role="button"
    aria-label="Hotspot trigger"
  >
    <div class="shop-look-2__container" style="--size: {{ size }}rem; --color: {{ color }}; --delay: {{ timer_delay }}s">
      <div class="shop-look-2__point shop-look-2__point--1"></div>
      <div class="shop-look-2__point shop-look-2__point--2"></div>
      <div class="shop-look-2__point shop-look-2__point--3"></div>
    </div>
  </xo-popover-trigger>
  <xo-popover
    class="shop-look-2__popover{% if settings.enable_border_radius %} shop-look-2__popover--radius{% endif %}"
    xo-name="hotspot-{{ random_number }}"
    xo-portal
    xo-placement="{{ placement | default: 'right-center' }}"
  >
    {% if final_card_type == 'shortcut' %}
      <div
        class="shop-look-2__shortcut-card{% if shortcut_image != blank %} shop-look-2__shortcut-card--image{% endif %}{% if settings.enable_border_radius %} shop-look-2__shortcut-card--radius{% endif %}{% if section.settings.card_color_scheme %} color-{{ section.settings.card_color_scheme }}{% endif %}"
        {% if shortcut_image != blank %}
          style="--shortcut-card-image: url('{{ shortcut_image | image_url: width: 900 }}');"
        {% endif %}
      >
        <div class="shop-look-2__shortcut-content">
          {% if shortcut_title != blank %}
            <h3 class="shop-look-2__shortcut-title">{{ shortcut_title | escape }}</h3>
          {% endif %}
          {% if shortcut_description != blank %}
            <div class="shop-look-2__shortcut-description">{{ shortcut_description }}</div>
          {% endif %}
          {% if shortcut_button_link != blank %}
            <div class="shop-look-2__shortcut-button">
              {% render 'button',
                text: final_shortcut_button_text,
                link: shortcut_button_link,
                style: 'primary',
                size: 'sm',
                attrs: 'download'
              %}
            </div>
          {% endif %}
        </div>
      </div>
    {% else %}
      {% render 'product-card-custom',
        product: product,
        show_image: section.settings.product_card_show_image,
        show_secondary_image: section.settings.product_card_show_secondary_image,
        show_price: section.settings.product_card_show_price,
        media_aspect_ratio: section.settings.product_card_aspect_ratio,
        card_color_scheme: section.settings.card_color_scheme,
        placeholder_image: placeholder_image
      %}
    {% endif %}
  </xo-popover>
</div>
