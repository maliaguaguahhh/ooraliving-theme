{% doc %}
Renders the store-wide shipping promise card.
Content comes from shop metafields so it is shared by every product and theme:
custom.shipping_promise_heading, custom.shipping_options (shipping_option metaobjects)
and custom.shipping_promise_note. Shown when Theme settings > Product purchase > Show shipping card is on.

@param {string} [heading] - Optional fallback heading when the shop metafield is empty.
@example
{% render 'product-shipping-promise' %}
{% enddoc %}

{% liquid
  assign shipping_promise_heading = shop.metafields.custom.shipping_promise_heading.value | default: heading
  assign shipping_options = shop.metafields.custom.shipping_options.value
  assign shipping_promise_note = shop.metafields.custom.shipping_promise_note.value
%}

{% if shipping_promise_heading != blank or shipping_options != blank %}
  {{ 'product-shipping-promise.css' | asset_url | stylesheet_tag }}

  <div class="oora-shipping-promise" aria-label="Shipping options">
    {% if shipping_promise_heading != blank %}
      <div class="oora-shipping-promise__guarantee">
        <span class="oora-shipping-promise__clock" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img">
            <circle cx="12" cy="12" r="8"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
        </span>
        <strong>{{ shipping_promise_heading | escape }}</strong>
      </div>
    {% endif %}

    {% if shipping_options != blank %}
      <div class="oora-shipping-promise__options">
        {% for option in shipping_options %}
          {% assign price_label = option.price_label.value %}
          <div class="oora-shipping-promise__option">
            <div class="oora-shipping-promise__topline">
              <strong>{{ option.name.value | escape }}</strong>
              {% assign price_label_check = price_label | downcase %}
              <b{% if price_label_check == 'free' %} class="oora-shipping-promise__free"{% endif %}>
                {{- price_label | escape -}}
              </b>
            </div>
            <span>{{ option.delivery_time.value | escape }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if shipping_promise_note != blank %}
      <small>{{ shipping_promise_note | escape }}</small>
    {% endif %}
  </div>
{% endif %}
