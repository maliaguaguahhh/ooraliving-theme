{% doc %}
Gift wrap control for one product color in the cart (drawer and cart page). It is shown once,
on the first cart line of that variant, and covers every unit of the variant in the cart:
a checkbox when there is one unit, otherwise "Gift wrap [n] of N". For the Gift Wrap line itself
it shows a short explanation instead, since its quantity follows the wrapped items.

@param {object} item - The cart line item.
@example
{% render 'gift-wrap-line-toggle', item: item %}
{% enddoc %}

{% liquid
  assign gift_wrap_product = settings.gift_wrapping_product
  assign gift_wrap_variant = gift_wrap_product.selected_or_first_available_variant
%}

{% if settings.gift_wrapping_enabled and gift_wrap_variant != blank %}
  {{ 'gift-wrap.css' | asset_url | stylesheet_tag }}
  {% if item.variant_id == gift_wrap_variant.id %}
    <p class="gift-wrap-line gift-wrap-line--info">
      {{ settings.gift_wrapping_line_info | default: 'One wrap for each gift-wrapped item.' | escape }}
    </p>
  {% elsif item.requires_shipping and item.product.gift_card? == false %}
    {% liquid
      assign variant_total = 0
      assign wrapped_total = 0
      assign first_key = ''
      for line in cart.items
        if line.variant_id == item.variant_id
          if first_key == ''
            assign first_key = line.key
          endif
          assign variant_total = variant_total | plus: line.quantity
          if line.properties['Gift wrap'] == 'Yes'
            assign wrapped_total = wrapped_total | plus: line.quantity
          endif
        endif
      endfor
      assign wrap_label = settings.gift_wrapping_label | default: 'Gift wrap this item'
      assign each_label = settings.gift_wrapping_each_label | default: 'each'
    %}
    {% if item.key == first_key %}
      {% if variant_total == 1 %}
        <label class="gift-wrap-line">
          <input
            type="checkbox"
            class="gift-wrap-line__input"
            data-gift-wrap-variant="{{ item.variant_id }}"
            {% if wrapped_total > 0 %}
              checked
            {% endif %}
          >
          <span>
            {{ wrap_label | escape }}
            {%- if gift_wrap_variant.price > 0 %}
              (+{{ gift_wrap_variant.price | money }} {{ each_label | escape }})
            {%- endif -%}
          </span>
        </label>
      {% else %}
        {% assign select_id = 'GiftWrapCount-' | append: item.variant_id | append: '-' | append: item.key | handleize %}
        <div class="gift-wrap-line gift-wrap-line--count">
          <label for="{{ select_id }}">{{ settings.gift_wrapping_count_label | default: 'Gift wrap' | escape }}</label>
          <select
            id="{{ select_id }}"
            class="gift-wrap-line__select"
            data-gift-wrap-variant="{{ item.variant_id }}"
          >
            {% for count in (0..variant_total) %}
              <option value="{{ count }}"{% if count == wrapped_total %} selected{% endif %}>{{ count }}</option>
            {% endfor %}
          </select>
          <span>
            {{ settings.gift_wrapping_of_label | default: 'of' | escape }} {{ variant_total }}
            {%- if gift_wrap_variant.price > 0 %}
              (+{{ gift_wrap_variant.price | money }} {{ each_label | escape }})
            {%- endif -%}
          </span>
        </div>
      {% endif %}
    {% endif %}
  {% endif %}
{% endif %}
