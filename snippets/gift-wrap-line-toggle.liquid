{% doc %}
Gift wrap control for one cart line (drawer and cart page), so it always matches the quantity
shown on that line: a round check when the line has one unit, otherwise "Gift wrap [n] of N"
for that line's N units. A line is either all wrapped or not; choosing part of it splits it into
a wrapped line and a plain one. Discounts can split one color into several lines (the bundle's
second unit is its own line), and each of those lines gets its own control. For the Gift Wrap
line itself it shows a short explanation instead, since its quantity follows the wrapped items.

@param {object} item - The cart line item.
@example
{% render 'gift-wrap-line-toggle', item: item %}
{% enddoc %}

{% liquid
  assign gift_wrap_product = settings.gift_wrapping_product
  assign gift_wrap_variant = gift_wrap_product.selected_or_first_available_variant
%}

{% if settings.gift_wrapping_enabled and gift_wrap_variant != blank %}
  {{ 'gift-wrap.css' | asset_url | stylesheet_tag }}
  {% if item.variant_id == gift_wrap_variant.id %}
    <p class="gift-wrap-line gift-wrap-line--info">
      {{ settings.gift_wrapping_line_info | default: 'One wrap for each gift-wrapped item.' | escape }}
    </p>
  {% elsif item.requires_shipping and item.product.gift_card? == false %}
    {% liquid
      assign line_wrapped = false
      if item.properties['Gift wrap'] == 'Yes'
        assign line_wrapped = true
      endif
      assign wrap_label = settings.gift_wrapping_label | default: 'Gift wrap this item'
    %}
    {% if item.quantity == 1 %}
      <label class="gift-wrap-line gift-wrap-line--check">
        <span>{{ wrap_label | escape }}</span>
        {% render 'gift-wrap-price-tag', variant: gift_wrap_variant %}
        <input
          type="checkbox"
          class="gift-wrap-check gift-wrap-check--small"
          data-gift-wrap-line="{{ item.key }}"
          {% if line_wrapped %}
            checked
          {% endif %}
        >
      </label>
    {% else %}
      {% assign select_id = 'GiftWrapCount-' | append: item.key | handleize %}
      <div class="gift-wrap-line gift-wrap-line--count">
        <label for="{{ select_id }}">{{ settings.gift_wrapping_count_label | default: 'Gift wrap' | escape }}</label>
        <select
          id="{{ select_id }}"
          class="gift-wrap-line__select"
          data-gift-wrap-line="{{ item.key }}"
        >
          {% for count in (0..item.quantity) %}
            <option
              value="{{ count }}"
              {% if line_wrapped and count == item.quantity %}
                selected
              {% elsif line_wrapped == false and count == 0 %}
                selected
              {% endif %}
            >
              {{ count }}
            </option>
          {% endfor %}
        </select>
        <span>{{ settings.gift_wrapping_of_label | default: 'of' | escape }} {{ item.quantity }}</span>
        {% render 'gift-wrap-price-tag', variant: gift_wrap_variant %}
      </div>
    {% endif %}
  {% endif %}
{% endif %}
