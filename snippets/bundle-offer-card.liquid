{% doc %}
Renders an optional bundle offer card for product and featured product buy buttons.
The offer (product to add, discount, text) comes from the product's custom.bundle_offer
metaobject; empty text fields fall back to Theme settings > Product purchase.
[discount] in any text is replaced with the offer's percentage, [price] in the button text
with the discounted price, [product] in the collapsed and button text with the offer product's name.
The collapsed row shows the tab label (the offer's, else Theme settings), a swatch for each of the two items
(the paired product's photo when it is a different product without a color swatch), and the
second item's discounted and regular price. Expanded, it shows a short note, the variant
selector and the add button.

@param {product} product - The primary product.
@param {object} offer - The product's bundle_offer metaobject.
@param {block} block - The buy button block (used for element ids).
@param {string} section_id - The section id used by XO cart components.
@example
{% render 'bundle-offer-card', product: product, offer: product.metafields.custom.bundle_offer.value, block: block, section_id: section.id %}
{% enddoc %}

{{ 'bundle-offer-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bundle-offer-card.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign offer_product = offer.offer_product.value | default: product
  assign discount_percent = offer.discount_percent.value | default: 15
  assign discount_label = discount_percent | append: ''
  assign discount_multiplier = 100 | minus: discount_percent
  assign primary_variant = product.selected_or_first_available_variant
  assign offer_variant = offer_product.selected_or_first_available_variant

  assign same_product = false
  if offer_product.id == product.id
    assign same_product = true
    assign offer_variant = primary_variant
  endif

  comment
    The Theme settings defaults say "a second", so an offer for a different product falls back
    to "Add [product]" wording unless its own metaobject sets the text.
  endcomment
  if same_product
    assign default_cta = settings.product_bundle_offer_cta_text | default: '+ Add a second - [price]'
    assign default_summary = settings.product_bundle_offer_summary | default: 'Add a second [product]'
  else
    assign default_cta = '+ Add [product] - [price]'
    assign default_summary = 'Add [product]'
  endif

  assign discounted_price = offer_variant.price | times: discount_multiplier | divided_by: 100
  assign discounted_price_money = discounted_price | money
  assign cta_template = offer.cta_text.value | default: default_cta
  assign cta_template = cta_template | replace: '[discount]', discount_label | replace: '[product]', offer_product.title
  assign cta_text = cta_template | replace: '[price]', discounted_price_money
  assign cta_text = cta_text | replace: '{{ price }}', discounted_price_money
  assign summary_text = offer.summary.value | default: default_summary | replace: '[discount]', discount_label | replace: '[product]', offer_product.title
  assign tab_text = offer.tab.value | default: settings.product_bundle_offer_tab | replace: '[discount]', discount_label
  assign body = offer.body.value | default: settings.product_bundle_offer_body | default: 'Another room, another color, or a gift.' | replace: '[discount]', discount_label
  assign selector_label = offer.selector_label.value | default: settings.product_bundle_offer_selector_label | default: 'Choose your second item' | replace: '[discount]', discount_label
  assign current_option_label = offer_variant.option1 | default: offer_variant.title
  if offer_variant.title == 'Default Title'
    assign current_option_label = offer_product.title
  endif
  assign current_option_handle = current_option_label | handleize
  assign current_swatch_style = ''
  assign offer_color_option = offer_product.options_with_values | first

  for value in offer_color_option.values
    assign value_label = value.name | default: value
    if value_label == current_option_label
      if value.swatch.image != blank
        assign swatch_image_url = value.swatch.image | image_url: width: 80
        assign current_swatch_style = '--bundle-swatch: url(' | append: swatch_image_url | append: ');'
      elsif value.swatch.color != blank
        assign current_swatch_style = '--bundle-swatch: ' | append: value.swatch.color | append: ';'
      endif
      break
    endif
  endfor

  comment
    A different paired product may have no color swatch; its photo fills the second circle instead.
  endcomment
  if same_product == false and current_swatch_style == ''
    assign offer_image = offer_variant.featured_image | default: offer_product.featured_image
    if offer_image != blank
      assign swatch_image_url = offer_image | image_url: width: 80
      assign current_swatch_style = '--bundle-swatch: url(' | append: swatch_image_url | append: ');'
    endif
  endif

  assign primary_option_label = primary_variant.option1 | default: primary_variant.title
  assign primary_option_handle = primary_option_label | handleize
  assign primary_swatch_style = ''
  assign primary_color_option = product.options_with_values | first

  for value in primary_color_option.values
    assign value_label = value.name | default: value
    if value_label == primary_option_label
      if value.swatch.image != blank
        assign swatch_image_url = value.swatch.image | image_url: width: 80
        assign primary_swatch_style = '--bundle-swatch: url(' | append: swatch_image_url | append: ');'
      elsif value.swatch.color != blank
        assign primary_swatch_style = '--bundle-swatch: ' | append: value.swatch.color | append: ';'
      endif
      break
    endif
  endfor
%}

{% if primary_variant != blank and offer_variant != blank %}
  <details
    class="xo-bundle-offer-card"
    data-bundle-offer-card
    data-primary-variant-id="{{ primary_variant.id }}"
    data-primary-available="{{ primary_variant.available }}"
    data-section-id="{{ section_id }}"
  >
    <summary class="xo-bundle-offer-card__summary{% if tab_text != blank %} xo-bundle-offer-card__summary--tab{% endif %}">
      {% if tab_text != blank %}
        <span class="xo-bundle-offer-card__tab">{{ tab_text }}</span>
      {% endif %}
      <span class="xo-bundle-offer-card__pair" aria-hidden="true">
        <span
          class="xo-bundle-offer-card__swatch"
          data-swatch-handle="{{ primary_option_handle }}"
          style="{{ primary_swatch_style }}"
        ></span>
        <span
          class="xo-bundle-offer-card__swatch"
          data-bundle-offer-current-swatch
          data-swatch-handle="{{ current_option_handle }}"
          style="{{ current_swatch_style }}"
        ></span>
      </span>
      <span class="xo-bundle-offer-card__summary-main">
        <span class="xo-bundle-offer-card__summary-text">{{ summary_text }}</span>
        <span class="xo-bundle-offer-card__summary-price">
          <span class="xo-bundle-offer-card__summary-sale" data-bundle-offer-summary-price>{{ discounted_price_money }}</span>
          <s class="xo-bundle-offer-card__summary-compare" data-bundle-offer-summary-compare>{{ offer_variant.price | money }}</s>
        </span>
      </span>
      <span class="xo-bundle-offer-card__summary-icon" aria-hidden="true">+</span>
    </summary>

    <div class="xo-bundle-offer-card__content">
      <p class="xo-bundle-offer-card__body">{{ body }}</p>

      {% if offer_product.variants.size > 1 %}
        <div class="xo-bundle-offer-card__selector" data-bundle-offer-selector>
          <button
            type="button"
            class="xo-bundle-offer-card__trigger"
            aria-expanded="false"
            aria-controls="BundleOfferMenu-{{ section_id }}-{{ block.id }}"
            data-bundle-offer-trigger
          >
            <span
              class="xo-bundle-offer-card__swatch"
              data-bundle-offer-current-swatch
              data-swatch-handle="{{ current_option_handle }}"
              style="{{ current_swatch_style }}"
              aria-hidden="true"
            ></span>
            <span class="xo-bundle-offer-card__trigger-text" data-bundle-offer-current-label>{{ current_option_label }}</span>
            <span class="xo-bundle-offer-card__chevron" aria-hidden="true">
              {% render 'icon', name: 'arrow-down', color: 'currentColor', size: '1.8rem' %}
            </span>
          </button>

          <div
            id="BundleOfferMenu-{{ section_id }}-{{ block.id }}"
            class="xo-bundle-offer-card__menu"
            role="listbox"
            aria-label="{{ selector_label | escape }}"
            data-bundle-offer-menu
            hidden
          >
            {% for variant in offer_product.variants %}
              {% liquid
                assign variant_discounted_price = variant.price | times: discount_multiplier | divided_by: 100
                assign variant_discounted_price_money = variant_discounted_price | money
                assign option_cta_text = cta_template | replace: '[price]', variant_discounted_price_money
                assign option_cta_text = option_cta_text | replace: '{{ price }}', variant_discounted_price_money
                assign option_label = variant.option1 | default: variant.title
                if variant.title == 'Default Title'
                  assign option_label = offer_product.title
                endif
                assign option_handle = option_label | handleize
                assign option_swatch_style = ''

                for value in offer_color_option.values
                  assign value_label = value.name | default: value
                  if value_label == option_label
                    if value.swatch.image != blank
                      assign swatch_image_url = value.swatch.image | image_url: width: 80
                      assign option_swatch_style = '--bundle-swatch: url(' | append: swatch_image_url | append: ');'
                    elsif value.swatch.color != blank
                      assign option_swatch_style = '--bundle-swatch: ' | append: value.swatch.color | append: ';'
                    endif
                    break
                  endif
                endfor

                if same_product == false and option_swatch_style == ''
                  assign option_image = variant.featured_image | default: offer_product.featured_image
                  if option_image != blank
                    assign swatch_image_url = option_image | image_url: width: 80
                    assign option_swatch_style = '--bundle-swatch: url(' | append: swatch_image_url | append: ');'
                  endif
                endif
              %}
              <button
                type="button"
                class="xo-bundle-offer-card__option"
                role="option"
                data-bundle-offer-option
                data-variant-id="{{ variant.id }}"
                data-available="{{ variant.available }}"
                data-cta-text="{{ option_cta_text | escape }}"
                data-price-text="{{ variant_discounted_price_money | escape }}"
                data-compare-text="{{ variant.price | money | escape }}"
                data-label="{{ option_label | escape }}"
                data-swatch-handle="{{ option_handle }}"
                data-swatch-style="{{ option_swatch_style | escape }}"
                aria-selected="{% if variant.id == offer_variant.id %}true{% else %}false{% endif %}"
              >
                <span
                  class="xo-bundle-offer-card__swatch"
                  data-swatch-handle="{{ option_handle }}"
                  style="{{ option_swatch_style }}"
                  aria-hidden="true"
                ></span>
                <span class="xo-bundle-offer-card__option-label">{{ option_label }}</span>
                <span class="xo-bundle-offer-card__option-price">{{ variant_discounted_price_money }}</span>
              </button>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <input
        type="hidden"
        data-bundle-offer-variant
        value="{{ offer_variant.id }}"
        data-available="{{ offer_variant.available }}"
        data-cta-text="{{ cta_text | escape }}"
      >

      <xo-cart-add
        class="xo-bundle-offer-card__button"
        xo-for-bundle
        xo-section-id="{{ section_id }}"
        xo-product-id="[{{ primary_variant.id }},{{ offer_variant.id }}]"
        xo-product-quantities="[1,1]"
        {% if primary_variant.available == false or offer_variant.available == false %}
          xo-disabled
        {% endif %}
        {% if settings.cart_type == 'page' %}
          xo-cart-redirection
        {% endif %}
      >
        {% render 'button', style: 'secondary', text: cta_text, size: 'md', block: true %}
      </xo-cart-add>
    </div>
  </details>
{% endif %}
