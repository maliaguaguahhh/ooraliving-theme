{% doc %}
Product page gift wrap card: a fixed-size block with the Gift Wrap photo (price tag on it), the
label and a short note, and a round check on the right. When checked, the item is added with the
"Gift wrap: Yes" property and the express checkout button is swapped for a Buy now button that
keeps the wrap. When the Gift Wrap product has images, the photo opens a dialog with up to three
of them and its description; without images a gift icon stands in. Renders nothing when gift
wrapping is off, the Gift Wrap product is unavailable, or the product does not ship.

@param {product} product - The product being bought.
@param {string} section_id - Section id, used to keep the dialog and checkbox ids unique on the page.
@example
{% render 'gift-wrap-option', product: product, section_id: section.id %}
{% enddoc %}

{% liquid
  assign gift_wrap_product = settings.gift_wrapping_product
  assign gift_wrap_variant = gift_wrap_product.selected_or_first_available_variant
  assign show_gift_wrap = false
  if settings.gift_wrapping_enabled and gift_wrap_variant != blank and product != blank
    if product.id != gift_wrap_product.id and product.gift_card? == false and product.selected_or_first_available_variant.requires_shipping
      assign show_gift_wrap = true
    endif
  endif
  assign gift_wrap_images = gift_wrap_product.images
  assign dialog_id = 'GiftWrapPreview-' | append: section_id
  assign check_id = 'GiftWrapCheck-' | append: section_id
  assign preview_label = settings.gift_wrapping_preview_label | default: 'See how it looks'
  assign dialog_title = settings.gift_wrapping_dialog_title | default: 'Our gift wrap'
%}

{% if show_gift_wrap %}
  {{ 'gift-wrap.css' | asset_url | stylesheet_tag }}
  <div class="gift-wrap-option">
    <div class="gift-wrap-card">
      <div class="gift-wrap-card__media{% if gift_wrap_images.size == 0 %} gift-wrap-card__media--placeholder{% endif %}">
        {% if gift_wrap_images.size > 0 %}
          <button
            type="button"
            class="gift-wrap-card__preview"
            aria-haspopup="dialog"
            aria-label="{{ preview_label | escape }}"
            data-gift-wrap-dialog-open="{{ dialog_id }}"
          >
            {{
              gift_wrap_images.first
              | image_url: width: 300
              | image_tag: loading: 'lazy', width: 96, height: 96, widths: '100, 200, 300', sizes: '96px', alt: ''
            }}
            <span class="gift-wrap-card__zoom" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="12" height="12" focusable="false">
                <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <path d="M10.4 10.4L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
        {% else %}
          <svg class="gift-wrap-card__icon" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" focusable="false">
            <rect x="3.5" y="9" width="17" height="11.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/>
            <rect x="2.5" y="6" width="19" height="3.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/>
            <path d="M12 6v14.5M12 6c-1.5-3-5-3.5-5-1.2C7 6 9.5 6 12 6zm0 0c1.5-3 5-3.5 5-1.2C17 6 14.5 6 12 6z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          </svg>
        {% endif %}
        {% render 'gift-wrap-price-tag', variant: gift_wrap_variant %}
      </div>
      <label class="gift-wrap-card__body" for="{{ check_id }}">
        <span class="gift-wrap-card__title">
          {{ settings.gift_wrapping_label | default: 'Gift wrap this item' | escape }}
        </span>
        {% if settings.gift_wrapping_description != blank or settings.gift_wrapping_info != blank %}
          <span class="gift-wrap-card__info" id="{{ check_id }}-info">
            {% if settings.gift_wrapping_description != blank %}
              {{ settings.gift_wrapping_description | escape }}
            {% endif %}
            {{ settings.gift_wrapping_info | escape }}
          </span>
        {% endif %}
      </label>
      <input
        type="checkbox"
        id="{{ check_id }}"
        class="gift-wrap-check"
        name="properties[Gift wrap]"
        value="Yes"
        {% if settings.gift_wrapping_description != blank or settings.gift_wrapping_info != blank %}
          aria-describedby="{{ check_id }}-info"
        {% endif %}
        data-gift-wrap-product
      >
    </div>


    {% if gift_wrap_images.size > 0 %}
      <dialog class="gift-wrap-dialog" id="{{ dialog_id }}" aria-labelledby="{{ dialog_id }}-title">
        <div class="gift-wrap-dialog__inner">
          <button type="button" class="gift-wrap-dialog__close" aria-label="{{ 'accessibility.close' | t | escape }}" data-gift-wrap-dialog-close>
            <span aria-hidden="true">&times;</span>
          </button>
          <h2 class="gift-wrap-dialog__title h5" id="{{ dialog_id }}-title">{{ dialog_title | escape }}</h2>
          <div class="gift-wrap-dialog__media gift-wrap-dialog__media--{{ gift_wrap_images.size | at_most: 3 }}">
            {% for image in gift_wrap_images limit: 3 %}
              {{
                image
                | image_url: width: 900
                | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 750px) 480px, 90vw', class: 'gift-wrap-dialog__image', alt: image.alt
              }}
            {% endfor %}
          </div>
          {% if gift_wrap_product.description != blank %}
            <div class="gift-wrap-dialog__text">{{ gift_wrap_product.description }}</div>
          {% elsif settings.gift_wrapping_description != blank %}
            <div class="gift-wrap-dialog__text"><p>{{ settings.gift_wrapping_description | escape }}</p></div>
          {% endif %}
          <p class="gift-wrap-dialog__price">
            {{ settings.gift_wrapping_label | default: 'Gift wrap this item' | escape }}
            {% render 'gift-wrap-price-tag', variant: gift_wrap_variant %}
          </p>
        </div>
      </dialog>
    {% endif %}
  </div>
{% endif %}
