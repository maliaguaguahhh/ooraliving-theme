{% comment %}
  Renders a product media tabs with thumbnails.

  Accepts:
  - zoom_enabled: {Boolean} Whether to enable zoom on the main image (optional)
  - show_thumbnails: {Boolean} Whether to show thumbnail carousel below the main image (optional)

  Usage:
  {% render 'featured-product-media' %}
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media
  assign hover_media = current_variant.metafields.custom.hover_image.value
  assign variant_images_grouping = product.metafields.custom.variant_images_grouping_list.value

  if hover_media == blank and variant_images_grouping != blank
    for grouping in variant_images_grouping
      assign variant_grouping_last = grouping.name.value | split: '__' | last
      for option in current_variant.options
        assign option_downcase = option | downcase
        if option_downcase == variant_grouping_last
          for file in grouping.file_grouping.value
            unless file.id == featured_media.id
              assign hover_media = file
              break
            endunless
          endfor
        endif
      endfor
    endfor
  endif
%}
{% if show_thumbnails == nil %}
  {% assign show_thumbnails = true %}
{% endif %}

<style>
  .featured-product-media xo-carousel-pagination,
  .featured-product-media xo-carousel-dynamic-bullets {
    display: none !important;
  }

  .featured-product-media__image {
    position: relative;
  }

  .featured-product-media__hover-image {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .featured-product-media__hover-image .xo-image,
  .featured-product-media__hover-image img {
    width: 100%;
    height: 100%;
  }

  .featured-product-media__image:hover .featured-product-media__hover-image,
  .featured-product-media__image--hover-active .featured-product-media__hover-image {
    opacity: 1;
  }
</style>

<div class='featured-product-media'>
  <xo-product-will-change xo-unique-id='featured-product-media-{{ section.id }}'>
    <xo-gallery xo-sync='false' xo-backdrop-color='transparent'>
      <xo-carousel>
        <xo-carousel-inner>
          <xo-carousel-list>
            {% if product.media != blank or featured_media != blank %}
              {% if featured_media != null %}
                {% case featured_media.media_type %}
                  {%- when 'image' -%}
                    <xo-carousel-slide>
                      <xo-gallery-item xo-src='{{ featured_media.src | image_url: width: 1200 }}'>
                        <div
                          class='featured-product-media__image{% if settings.enable_border_radius %} featured-product-media__image--radius{% endif %}'
                          {% if hover_media != blank %}
                            data-featured-product-hover-swap
                          {% endif %}
                        >
                          {% render 'media', type: 'image', media: featured_media, image_lazyload: false, image_widths: '375, 550, 750, 900' %}
                          {% if hover_media != blank %}
                            <div class='featured-product-media__hover-image' aria-hidden='true'>
                              {% render 'image', image: hover_media, lazyload: false, image_widths: '375, 550, 750, 900' %}
                            </div>
                          {% endif %}
                        </div>
                      </xo-gallery-item>
                    </xo-carousel-slide>
                  {% when 'model' %}
                    <xo-carousel-slide>
                      <div data-media-id='{{ media.id }}' style='height: 100%; width: 100%'>
                        <div class='featured-product-media__image{% if settings.enable_border_radius %} featured-product-media__image--radius{% endif %}'>
                          <div style='height: 100%; width: 100%; position: relative'>
                            <xo-product-model style='height: 100%'>
                              <button
                                class='xo-product-model__poster'
                                type='button'
                                aria-label='Button 3D'
                                role='button'
                                tabindex='0'
                              >
                                <span class='xo-product-model__poster-button'>
                                  {% render 'icon', name: '3d-model', icon_size: '20' %}
                                </span>
                                <div class='xo-product-model__poster-image'>
                                  <img
                                    is='xo-lazyload'
                                    width='810'
                                    height='590'
                                    src='{{ featured_media | image_url: width: 550, height: 550 }}'
                                    alt='{{ featured_media.preview_image.alt | escape }}'
                                  >
                                  <div class='xo-lazyload-overlay'></div>
                                </div>
                              </button>
                              <template>{% render 'media', type: 'model', media: featured_media %}</template>
                            </xo-product-model>
                            <button
                              class='xb-product-model__btn-view'
                              type='button'
                              aria-label='{{ 'products.product.xr_button_label' | t }}'
                              data-shopify-xr
                              data-shopify-model3d-id='{{ media.id }}'
                              data-shopify-title='title'
                              data-shopify-xr-hidden
                            >
                              <span>
                                {% render 'icon', name: '3d-model', icon_size: '10' %}
                              </span>
                              {{ 'products.product.xr_button' | t }}
                            </button>
                          </div>
                        </div>
                      </div>
                    </xo-carousel-slide>
                  {% else %}
                    <xo-carousel-slide>
                      <div style='height: 100%;'>
                        <div class='featured-product-media__image{% if settings.enable_border_radius %} featured-product-media__image--radius{% endif %}'>
                          {% render 'media', type: featured_media.media_type, media: featured_media, enable_video_looping: true, controls: true, muted: true, autoplay: false %}
                        </div>
                      </div>
                    </xo-carousel-slide>
                {% endcase %}
              {% endif %}
              {% for media in product.media %}
                {% if variant_images contains media.src and section.settings.hide_variants %}
                  {% continue %}
                {% endif %}
                {%- unless media.id == featured_media.id -%}
                  {% case media.media_type %}
                    {%- when 'image' -%}
                      <xo-carousel-slide>
                        <xo-gallery-item xo-src='{{ media.src | image_url: width: 1200 }}'>
                          <div style='height: 100%;'>
                            <div class='featured-product-media__image{% if settings.enable_border_radius %} featured-product-media__image--radius{% endif %}'>
                              {% render 'media', type: 'image', media: media, image_lazyload: false, image_widths: '375, 550, 750, 900' %}
                            </div>
                          </div>
                        </xo-gallery-item>
                      </xo-carousel-slide>
                    {% when 'model' %}
                      <xo-carousel-slide>
                        <div style='height: 100%;' data-media-id='{{ media.id }}'>
                          <div class='featured-product-media__image{% if settings.enable_border_radius %} featured-product-media__image--radius{% endif %}'>
                            <div style='height: 100%; position: relative'>
                              <xo-product-model style='height: 100%'>
                                <button
                                  class='xo-product-model__poster'
                                  type='button'
                                  aria-label='Button 3D'
                                  role='button'
                                  tabindex='0'
                                >
                                  <span class='xo-product-model__poster-button'>
                                    {% render 'icon', name: '3d-model', icon_size: '20' %}
                                  </span>
                                  <div class='xo-product-model__poster-image'>
                                    <img
                                      is='xo-lazyload'
                                      width='810'
                                      height='590'
                                      src='{{ media | image_url: width: 550, height: 550 }}'
                                      alt='{{ media.preview_image.alt | escape }}'
                                    >
                                    <div class='xo-lazyload-overlay'></div>
                                  </div>
                                </button>
                                <template>{% render 'media', type: 'model', media: media %}</template>
                              </xo-product-model>
                              <button
                                class='xb-product-model__btn-view'
                                type='button'
                                aria-label='{{ 'products.product.xr_button_label' | t }}'
                                data-shopify-xr
                                data-shopify-model3d-id='{{ media.id }}'
                                data-shopify-title='title'
                                data-shopify-xr-hidden
                              >
                                <span>
                                  {% render 'icon', name: '3d-model', icon_size: '10' %}
                                </span>
                                {{ 'products.product.xr_button' | t }}
                              </button>
                            </div>
                          </div>
                        </div>
                      </xo-carousel-slide>
                    {%- else -%}
                      <xo-carousel-slide>
                        <div class='featured-product-media__image{% if settings.enable_border_radius %} featured-product-media__image--radius{% endif %}'>
                          {% render 'media', type: media.media_type, media: media, enable_video_looping: true, controls: true, muted: true, autoplay: false %}
                        </div>
                      </xo-carousel-slide>
                  {% endcase %}
                {%- endunless -%}
              {% endfor %}
            {%- else -%}
              <xo-carousel-slide>
                <div class='featured-product-media__image-placeholder'>
                  {% render 'image', placeholder: 'detailed-apparel-1' %}
                </div>
              </xo-carousel-slide>
            {% endif %}
          </xo-carousel-list>
        </xo-carousel-inner>
        {% if show_thumbnails %}
          <div class='featured-product-media__content'>
            <xo-carousel-thumbnail
              class='featured-product-media__thumbnail'
              xo-per-view='6'
              xo-breakpoints='
                {
                  600: {
                    perView: 4,
                  },
                  1000: {
                    perView: 5,
                  },
                }
              '
            >
              <xo-carousel-inner>
                <xo-carousel-list>
                  {%- if featured_media != null -%}
                    {% case featured_media.media_type %}
                      {%- when 'image' -%}
                        <xo-carousel-slide class='featured-product-media__thumb-slide'>
                          <div class='featured-product-media__thumb-image{% if settings.enable_border_radius %} featured-product-media__thumb-image--radius{% endif %}'>
                            {% render 'media', type: 'image', media: featured_media %}
                          </div>
                        </xo-carousel-slide>
                      {%- when 'model' -%}
                        <xo-carousel-slide class='featured-product-media__thumb-slide'>
                          <div class='featured-product-media__thumb-image{% if settings.enable_border_radius %} featured-product-media__thumb-image--radius{% endif %}'>
                            {% render 'media', type: 'model', media: featured_media %}
                          </div>
                        </xo-carousel-slide>
                      {%- else -%}
                        <xo-carousel-slide class='featured-product-media__thumb-slide'>
                          <div class='featured-product-media__thumb-image{% if settings.enable_border_radius %} featured-product-media__thumb-image--radius{% endif %}'>
                            {% render 'media', type: featured_media.media_type, media: featured_media, enable_video_looping: true, controls: true, muted: true, autoplay: false %}
                          </div>
                        </xo-carousel-slide>
                    {% endcase %}
                  {%- endif -%}
                  {% for media in product.media %}
                    {% if variant_images contains media.src and section.settings.hide_variants %}
                      {% continue %}
                    {% endif %}
                    {% unless media.id == featured_media.id %}
                      {% case media.media_type %}
                        {%- when 'image' -%}
                          <xo-carousel-slide class='featured-product-media__thumb-slide'>
                            <div class='featured-product-media__thumb-image{% if settings.enable_border_radius %} featured-product-media__thumb-image--radius{% endif %}'>
                              {% render 'media', type: 'image', media: media.preview_image %}
                            </div>
                          </xo-carousel-slide>
                        {%- when 'model' -%}
                          <xo-carousel-slide class='featured-product-media__thumb-slide'>
                            <div class='featured-product-media__thumb-image{% if settings.enable_border_radius %} featured-product-media__thumb-image--radius{% endif %}'>
                              {% render 'media', type: 'model', media: media %}
                            </div>
                          </xo-carousel-slide>
                        {%- else -%}
                          <xo-carousel-slide class='featured-product-media__thumb-slide'>
                            <div class='featured-product-media__thumb-image{% if settings.enable_border_radius %} featured-product-media__thumb-image--radius{% endif %}'>
                              {% render 'media', type: media.media_type, media: media, enable_video_looping: true, controls: true, muted: true, autoplay: false %}
                            </div>
                          </xo-carousel-slide>
                      {% endcase %}
                    {% endunless %}
                  {% endfor %}
                </xo-carousel-list>
              </xo-carousel-inner>
            </xo-carousel-thumbnail>
          </div>
        {% endif %}
      </xo-carousel>
    </xo-gallery>
    <!-- Scroll Progress Bar -->
<div class="fpm-progress-wrap">
  <div class="fpm-progress-bar">
    <div class="fpm-progress-fill"></div>
  </div>
</div>

<style>
  .fpm-progress-wrap {
    padding: 8px 0 2px;
  }
  .fpm-progress-bar {
    height: 2px;
    background: rgba(0,0,0,0.12);
    border-radius: 2px;
    overflow: hidden;
  }
  .fpm-progress-fill {
    height: 100%;
    width: 0%;
    background: #222;
    border-radius: 2px;
    transition: width 0.25s ease;
  }
</style>

<script>
  (() => {
    function initProgressBar() {
      const gallery = document.querySelector('.featured-product-media');
      if (!gallery) return;

      const fill = gallery.querySelector('.fpm-progress-fill');
      const carousel = gallery.querySelector('xo-carousel');
      if (!fill || !carousel) return;

      const slides = carousel.querySelectorAll('xo-carousel-slide');
      const total = slides.length;

      function updateBar(index) {
        const pct = total > 1 ? ((index + 1) / total) * 100 : 100;
        fill.style.width = pct + '%';
      }

      carousel.addEventListener('xo:carousel:change', (e) => {
        updateBar(e.detail?.activeIndex ?? 0);
      });

      // 初始显示第一张的进度
      updateBar(0);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProgressBar);
    } else {
      initProgressBar();
    }
  })();
</script>



  </xo-product-will-change>
</div>

<script>
  (() => {
    if (window.__featuredProductHoverSwapInitialized) return;
    window.__featuredProductHoverSwapInitialized = true;

    document.addEventListener(
      'click',
      (event) => {
        const target = event.target.closest('[data-featured-product-hover-swap]');
        if (!target) return;

        event.preventDefault();
        event.stopPropagation();
        target.classList.toggle('featured-product-media__image--hover-active');
      },
      true
    );

    document.addEventListener('mouseleave', (event) => {
      const target = event.target.closest?.('[data-featured-product-hover-swap]');
      if (!target) return;

      target.classList.remove('featured-product-media__image--hover-active');
    }, true);
  })();
</script>
