{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'featured-product-content.css' | asset_url | stylesheet_tag }}
{{ 'featured-product-media.css' | asset_url | stylesheet_tag }}
{{ 'recipient-form.css' | asset_url | stylesheet_tag }}
{{ '3d-model.css' | asset_url | stylesheet_tag }}
{{ 'inventory-status.css' | asset_url | stylesheet_tag }}

{% liquid
  assign product = section.settings.select_product
  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
  assign hide_variants = section.settings.hide_variants
%}

<section {% render 'section-attr' %}>
  <div class="featured-product-special">
    <xo-product
      xo-selected-or-first-available-variant-id="{{ product.selected_or_first_available_variant.id }}"
      xo-featured-product
      xo-product-id="{{ product.id }}"
      xo-product-url="{{ shop.url }}{{ product.url }}"
      xo-section-id="{{ section.id }}"
      class="featured-product-special__product"
    >
      <xo-container class="featured-product-special__container">
        <xo-grid class="featured-product-special__grid">
          <div class="featured-product-special__image" style="--xs: 12; --md: 12; --lg: 7">
            {% render 'featured-product-media', zoom_enabled: true, product: product, variant_images: variant_images, hide_variants: hide_variants, show_thumbnails: false %}
          </div>
          <div class="featured-product-special__content" style="--xs: 12; --md: 12; --lg: 5;">
            {% render 'featured-product-content', product: product %}
          </div>
        </xo-grid>
      </xo-container>
      {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
      {%- if first_3d_model -%}
        <script type="application/json" id="xo-3d-product-json-{{ product.id }}">
          {{ product.media | where: 'media_type', 'model' | json }}
        </script>
      {%- endif -%}
      {% render 'product-data', product: product %}
    </xo-product>
    {% render 'main-product-ld-json' %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_product_special.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay",
      "custom.popups",
      "custom.features"
    ]
  },
  "settings": [
    {
      "type": "product",
      "id": "select_product",
      "label": "t:sections.featured_product_special.settings.product.label"
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "default": false,
      "label": "t:sections.featured_product_special.settings.hide_variants.label"
    },
    {
      "type": "header",
      "content": "General settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "number",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.featured_product_special.blocks.custom_liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.featured_product_special.blocks.custom_liquid.settings.custom_liquid.label",
          "info": "t:sections.featured_product_special.blocks.custom_liquid.settings.custom_liquid.info"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:sections.featured_product_special.blocks.title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:sections.featured_product_special.blocks.price",
      "limit": 1
    },
    {
      "type": "description",
      "name": "t:sections.featured_product_special.blocks.description",
      "limit": 1
    },
    {
      "type": "quantity_picker",
      "name": "t:sections.featured_product_special.blocks.quantity_picker",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variants",
      "name": "t:sections.featured_product_special.blocks.variants.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.featured_product_special.blocks.variants.settings.variant_pills.paragraph"
        },
        {
          "type": "select",
          "id": "variant_style",
          "label": "t:sections.featured_product_special.blocks.variants.settings.variant_style.label",
          "options": [
            {
              "value": "radio",
              "label": "t:sections.featured_product_special.blocks.variants.settings.variant_style.option_1.label"
            },
            {
              "value": "boxed",
              "label": "t:sections.featured_product_special.blocks.variants.settings.variant_style.option_2.label"
            },
            {
              "value": "select",
              "label": "t:sections.featured_product_special.blocks.variants.settings.variant_style.option_3.label"
            }
          ],
          "default": "select"
        },
        {
          "type": "select",
          "id": "variant_color_style",
          "label": "t:sections.featured_product_special.blocks.variants.settings.variant_color_style.label",
          "info": "t:sections.featured_product_special.blocks.variants.settings.variant_color_style.info",
          "options": [
            {
              "value": "radio",
              "label": "t:sections.featured_product_special.blocks.variants.settings.variant_color_style.option_1.label"
            },
            {
              "value": "boxed",
              "label": "t:sections.featured_product_special.blocks.variants.settings.variant_color_style.option_2.label"
            },
            {
              "value": "select",
              "label": "t:sections.featured_product_special.blocks.variants.settings.variant_color_style.option_3.label"
            },
            {
              "value": "color",
              "label": "t:sections.featured_product_special.blocks.variants.settings.variant_color_style.option_4.label"
            },
            {
              "value": "variant_image",
              "label": "t:sections.featured_product_special.blocks.variants.settings.variant_color_style.option_5.label"
            }
          ],
          "default": "color"
        },
        {
          "type": "checkbox",
          "id": "enable_color_groups",
          "label": "Group color swatches",
          "default": true
        },
        {
          "type": "text",
          "id": "limited_edition_label",
          "label": "Limited edition label",
          "default": "Limited Edition"
        },
        {
          "type": "textarea",
          "id": "limited_edition_colors",
          "label": "Limited edition colors",
          "info": "Comma-separated color option values, for example: Dust Rose, Stone.",
          "default": "Dust Rose"
        },
        {
          "type": "text",
          "id": "classic_shades_label",
          "label": "Classic shades label",
          "default": "Classic Shades"
        }
      ]
    },
    {
      "type": "buy_button",
      "name": "t:sections.featured_product_special.blocks.buy_button.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:sections.featured_product_special.blocks.buy_button.show_dynamic_checkout.label",
          "info": "t:sections.featured_product_special.blocks.buy_button.show_dynamic_checkout.info",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_gift_card_recipient",
          "label": "t:sections.featured_product_special.blocks.buy_button.show_gift_card_recipient.label",
          "info": "t:sections.featured_product_special.blocks.buy_button.show_gift_card_recipient.info",
          "default": false
        },
        {
          "type": "header",
          "content": "Shipping promise"
        },
        {
          "type": "checkbox",
          "id": "show_shipping_promise",
          "label": "Show shipping promise",
          "default": true
        },
        {
          "type": "text",
          "id": "shipping_promise_heading",
          "label": "Shipping promise heading",
          "default": "Ships out within 24–48 hours when inventory is available"
        },
        {
          "type": "header",
          "content": "Restock notice"
        },
        {
          "type": "checkbox",
          "id": "enable_preorder_message",
          "label": "Show restock notice",
          "default": true
        },
        {
          "type": "text",
          "id": "preorder_status_text",
          "label": "Pre-order inventory status",
          "default": "Available for pre-order"
        },
        {
          "type": "text",
          "id": "preorder_button_label",
          "label": "Pre-order button label",
          "default": "Pre-order"
        },
        {
          "type": "textarea",
          "id": "preorder_arrival_text",
          "label": "Restock notice text",
          "default": "Expected to restock around October 14. Pre-orders will ship as soon as inventory arrives."
        },
        {
          "type": "color",
          "id": "preorder_color",
          "label": "Restock notice color",
          "default": "#4f8068"
        },
        {
          "type": "header",
          "content": "Bundle offer"
        },
        {
          "type": "checkbox",
          "id": "enable_bundle_offer",
          "label": "Enable bundle offer",
          "default": false
        },
        {
          "type": "product",
          "id": "bundle_offer_product",
          "label": "Bundle product",
          "info": "Leave blank to add another of the current product."
        },
        {
          "type": "image_picker",
          "id": "bundle_offer_image",
          "label": "Bundle image"
        },
        {
          "type": "range",
          "id": "bundle_offer_discount_percent",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "%",
          "label": "Displayed discount",
          "default": 15
        },
        {
          "type": "text",
          "id": "bundle_offer_summary",
          "label": "Collapsed text",
          "default": "Add another and save 15%"
        },
        {
          "type": "text",
          "id": "bundle_offer_badge",
          "label": "Badge",
          "default": "Bundle offer"
        },
        {
          "type": "text",
          "id": "bundle_offer_heading",
          "label": "Heading",
          "default": "Add another for 15% off?"
        },
        {
          "type": "textarea",
          "id": "bundle_offer_body",
          "label": "Body",
          "default": "Another room, another color, or a gift."
        },
        {
          "type": "text",
          "id": "bundle_offer_selector_label",
          "label": "Variant selector label",
          "default": "Choose your second item"
        },
        {
          "type": "text",
          "id": "bundle_offer_cta_text",
          "label": "Button text",
          "info": "Use [price] to show the discounted second item price.",
          "default": "+ Add a second - [price]"
        }
      ]
    },
    {
      "type": "inventory_status",
      "name": "t:sections.main_product.blocks.inventory_status.name",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "low_inventory_threshold",
          "label": "t:sections.main_product.blocks.inventory_status.settings.low_inventory_threshold.label",
          "info": "t:sections.main_product.blocks.inventory_status.settings.low_inventory_threshold.info",
          "min": 0,
          "max": 25,
          "step": 1,
          "default": 15
        },
        {
          "type": "select",
          "id": "show_inventory_count",
          "label": "t:sections.main_product.blocks.inventory_status.settings.show_inventory_count.label",
          "options": [
            {
              "value": "none",
              "label": "t:sections.main_product.blocks.inventory_status.settings.show_inventory_count.option__1.label"
            },
            {
              "value": "low-inventory-threshold",
              "label": "t:sections.main_product.blocks.inventory_status.settings.show_inventory_count.option__2.label"
            },
            {
              "value": "always",
              "label": "t:sections.main_product.blocks.inventory_status.settings.show_inventory_count.option__3.label"
            }
          ],
          "default": "low-inventory-threshold"
        },
        {
          "type": "text",
          "id": "preorder_status_text",
          "label": "Pre-order inventory status",
          "default": "Available for pre-order"
        },
        {
          "type": "color",
          "id": "color_in_stock",
          "label": "t:sections.main_product.blocks.inventory_status.settings.color_in_stock.label",
          "default": "#10A71F"
        },
        {
          "type": "color",
          "id": "color_out_stock",
          "label": "t:sections.main_product.blocks.inventory_status.settings.color_out_stock.label",
          "default": "#DA1E28"
        }
      ]
    },
    {
      "type": "share",
      "name": "t:sections.featured_product_special.blocks.share.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "share_option",
          "label": "t:sections.featured_product_special.blocks.share_option.label",
          "options": [
            {
              "value": "link",
              "label": "t:sections.featured_product_special.blocks.share_option.option_1.label"
            },
            {
              "value": "social",
              "label": "t:sections.featured_product_special.blocks.share_option.option_2.label"
            }
          ],
          "default": "link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_product_special.presets.name",
      "blocks": [
        {
          "type": "title",
          "settings": {}
        },
        {
          "type": "description",
          "settings": {}
        },
        {
          "type": "price",
          "settings": {}
        },
        {
          "type": "quantity_picker",
          "settings": {}
        },
        {
          "type": "variants",
          "settings": {}
        },
        {
          "type": "buy_button",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false,
            "show_shipping_promise": true,
            "shipping_promise_heading": "Ships out within 24–48 hours when inventory is available",
            "enable_preorder_message": true,
            "preorder_status_text": "Available for pre-order",
            "preorder_button_label": "Pre-order",
            "preorder_arrival_text": "Expected to restock around October 14. Pre-orders will ship as soon as inventory arrives.",
            "preorder_color": "#4f8068"
          }
        }
      ],
      "settings": {
        "select_product": "",
        "color_scheme": "",
        "background_color": "",
        "background_gradient": "",
        "padding_top_desktop": 50,
        "padding_bottom_desktop": 50,
        "padding_top_mobile": 50,
        "padding_bottom_mobile": 50
      }
    }
  ]
}
{% endschema %}
