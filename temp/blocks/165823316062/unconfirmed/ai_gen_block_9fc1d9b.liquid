{% doc %}
  @prompt
    Update the existing "Product comparison" block/section to match this reference design: A comparison section titled "Lumi 2 compared to..." with a two-column layout. Left column shows "LUMI 2" and right column has a dropdown selector starting with "LASER". Each column has a lifestyle photo of a woman at the top (rounded rectangle image frames with a light pink background). Below the images, there are comparison rows with checkmark icons (pink filled circle with checkmark) for the left/product column and X icons (outlined circle with X) for the right/competitor column. Each row has a short feature label in bold below the icon and a short description above it. Example rows: Row 1 - Left: checkmark + "Keep self-care to yourself and DIY at home" + bold "Groom yourself"; Right: X + "Travel to the clinic every few weeks". Row 2 - Left: checkmark + "Complete sessions on your own schedule"; Right: X + "Wait weeks between sessions". The overall background is a soft blush/light pink. Typography is bold sans-serif for the title and labels., make it into two collumn side by side in mobile setting, 产品heading加上下面的图放在一个stack里面 并且高度控制在一个值, 这样图片左右才能对齐, 把heading放在frame里面, 统一高度, 这样dropdown和左边没有dropdown的高度能一直,下面的图能对齐
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-comparison-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px {{ block.settings.section_padding_horizontal }}px;
  }

  .ai-product-comparison__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-product-comparison__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-product-comparison__columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-product-comparison__column-{{ ai_gen_id }} {
    background-color: {{ block.settings.column_background }};
    border-radius: {{ block.settings.column_border_radius }}px;
    padding: {{ block.settings.column_padding }}px;
  }

  .ai-product-comparison__column-header-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-product-comparison__heading-frame-{{ ai_gen_id }} {
    height: {{ block.settings.heading_frame_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin-bottom: {{ block.settings.column_title_spacing }}px;
  }

  .ai-product-comparison__column-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.column_title_color }};
    margin: 0;
    text-align: center;
  }

  .ai-product-comparison__dropdown-{{ ai_gen_id }} {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid {{ block.settings.dropdown_border_color }};
    border-radius: {{ block.settings.dropdown_border_radius }}px;
    background-color: {{ block.settings.dropdown_background }};
    color: {{ block.settings.dropdown_text_color }};
    font-size: {{ block.settings.dropdown_font_size }}px;
    font-weight: 600;
    cursor: pointer;
  }

  .ai-product-comparison__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-comparison__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-comparison__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-comparison__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-product-comparison__features-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.feature_gap }}px;
  }

  .ai-product-comparison__feature-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-product-comparison__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    flex-shrink: 0;
  }

  .ai-product-comparison__icon-{{ ai_gen_id }}--check {
    background-color: {{ block.settings.check_icon_background }};
  }

  .ai-product-comparison__icon-{{ ai_gen_id }}--x {
    background-color: transparent;
    border: 2px solid {{ block.settings.x_icon_color }};
  }

  .ai-product-comparison__icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size | times: 0.6 }}px;
    height: {{ block.settings.icon_size | times: 0.6 }}px;
  }

  .ai-product-comparison__feature-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.4;
    margin-bottom: 6px;
  }

  .ai-product-comparison__feature-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: 700;
    color: {{ block.settings.label_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-product-comparison__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-comparison__column-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_title_size | times: 0.85 }}px;
    }

    .ai-product-comparison__dropdown-{{ ai_gen_id }} {
      font-size: {{ block.settings.dropdown_font_size | times: 0.9 }}px;
      padding: 8px 10px;
    }

    .ai-product-comparison__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.85 }}px;
      height: {{ block.settings.icon_size | times: 0.85 }}px;
    }

    .ai-product-comparison__icon-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size | times: 0.5 }}px;
      height: {{ block.settings.icon_size | times: 0.5 }}px;
    }

    .ai-product-comparison__feature-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.85 }}px;
    }

    .ai-product-comparison__feature-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<product-comparison-{{ ai_gen_id }}
  class="ai-product-comparison-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-comparison__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-product-comparison__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-product-comparison__columns-{{ ai_gen_id }}">
      <div class="ai-product-comparison__column-{{ ai_gen_id }}">
        <div class="ai-product-comparison__column-header-{{ ai_gen_id }}">
          <div class="ai-product-comparison__heading-frame-{{ ai_gen_id }}">
            <h3 class="ai-product-comparison__column-title-{{ ai_gen_id }}">
              {{ block.settings.product_name }}
            </h3>
          </div>

          <div class="ai-product-comparison__image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.product_image %}
              <img
                src="{{ block.settings.product_image | image_url: width: 600 }}"
                alt="{{ block.settings.product_image.alt | escape }}"
                loading="lazy"
                width="600"
                height="600"
                class="ai-product-comparison__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-product-comparison__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>

        <div class="ai-product-comparison__features-{{ ai_gen_id }}">
          {% for i in (1..5) %}
            {% liquid
              assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
              assign feature_description_key = 'feature_' | append: i | append: '_description'
              assign feature_label_key = 'feature_' | append: i | append: '_label'
              assign product_has_key = 'feature_' | append: i | append: '_product_has'

              assign feature_enabled = block.settings[feature_enabled_key]
              assign feature_description = block.settings[feature_description_key]
              assign feature_label = block.settings[feature_label_key]
              assign product_has = block.settings[product_has_key]
            %}

            {% if feature_enabled %}
              <div class="ai-product-comparison__feature-{{ ai_gen_id }}">
                <div class="ai-product-comparison__icon-{{ ai_gen_id }} ai-product-comparison__icon-{{ ai_gen_id }}--check">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="{{ block.settings.check_icon_color }}"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                {% if feature_description != blank %}
                  <div class="ai-product-comparison__feature-description-{{ ai_gen_id }}">
                    {{ feature_description }}
                  </div>
                {% endif %}
                {% if feature_label != blank %}
                  <div class="ai-product-comparison__feature-label-{{ ai_gen_id }}">
                    {{ feature_label }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="ai-product-comparison__column-{{ ai_gen_id }}">
        <div class="ai-product-comparison__column-header-{{ ai_gen_id }}">
          <div class="ai-product-comparison__heading-frame-{{ ai_gen_id }}">
            <select class="ai-product-comparison__dropdown-{{ ai_gen_id }}" data-competitor-selector>
              {% for i in (1..3) %}
                {% liquid
                  assign competitor_enabled_key = 'competitor_' | append: i | append: '_enabled'
                  assign competitor_name_key = 'competitor_' | append: i | append: '_name'

                  assign competitor_enabled = block.settings[competitor_enabled_key]
                  assign competitor_name = block.settings[competitor_name_key]
                %}

                {% if competitor_enabled and competitor_name != blank %}
                  <option value="{{ i }}">{{ competitor_name }}</option>
                {% endif %}
              {% endfor %}
            </select>
          </div>

          {% for i in (1..3) %}
            {% liquid
              assign competitor_enabled_key = 'competitor_' | append: i | append: '_enabled'
              assign competitor_image_key = 'competitor_' | append: i | append: '_image'

              assign competitor_enabled = block.settings[competitor_enabled_key]
              assign competitor_image = block.settings[competitor_image_key]
            %}

            {% if competitor_enabled %}
              <div
                class="ai-product-comparison__image-wrapper-{{ ai_gen_id }}"
                data-competitor-image="{{ i }}"
                style="{% if i != 1 %}display: none;{% endif %}"
              >
                {% if competitor_image %}
                  <img
                    src="{{ competitor_image | image_url: width: 600 }}"
                    alt="{{ competitor_image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                    class="ai-product-comparison__image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-product-comparison__image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="ai-product-comparison__features-{{ ai_gen_id }}">
          {% for i in (1..5) %}
            {% liquid
              assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
              assign feature_description_key = 'feature_' | append: i | append: '_description'
              assign feature_label_key = 'feature_' | append: i | append: '_label'

              assign feature_enabled = block.settings[feature_enabled_key]
            %}

            {% if feature_enabled %}
              {% for j in (1..3) %}
                {% liquid
                  assign competitor_enabled_key = 'competitor_' | append: j | append: '_enabled'
                  assign competitor_has_key = 'competitor_' | append: j | append: '_feature_' | append: i

                  assign competitor_enabled = block.settings[competitor_enabled_key]
                  assign competitor_has = block.settings[competitor_has_key]
                %}

                {% if competitor_enabled %}
                  <div
                    class="ai-product-comparison__feature-{{ ai_gen_id }}"
                    data-competitor-feature="{{ j }}"
                    style="{% if j != 1 %}display: none;{% endif %}"
                  >
                    {% if competitor_has %}
                      <div class="ai-product-comparison__icon-{{ ai_gen_id }} ai-product-comparison__icon-{{ ai_gen_id }}--check">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="{{ block.settings.check_icon_color }}"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                      </div>
                    {% else %}
                      <div class="ai-product-comparison__icon-{{ ai_gen_id }} ai-product-comparison__icon-{{ ai_gen_id }}--x">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="{{ block.settings.x_icon_color }}"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <line x1="18" y1="6" x2="6" y2="18"></line>
                          <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                      </div>
                    {% endif %}

                    {% liquid
                      assign competitor_desc_key = 'competitor_' | append: j | append: '_feature_' | append: i | append: '_desc'
                      assign competitor_desc = block.settings[competitor_desc_key]
                    %}

                    {% if competitor_desc != blank %}
                      <div class="ai-product-comparison__feature-description-{{ ai_gen_id }}">
                        {{ competitor_desc }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</product-comparison-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductComparison{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.selector = this.querySelector('[data-competitor-selector]');
        if (!this.selector) return;

        this.selector.addEventListener('change', this.handleCompetitorChange.bind(this));
      }

      handleCompetitorChange(event) {
        const selectedValue = event.target.value;

        const images = this.querySelectorAll('[data-competitor-image]');
        images.forEach(image => {
          if (image.dataset.competitorImage === selectedValue) {
            image.style.display = '';
          } else {
            image.style.display = 'none';
          }
        });

        const features = this.querySelectorAll('[data-competitor-feature]');
        features.forEach(feature => {
          if (feature.dataset.competitorFeature === selectedValue) {
            feature.style.display = '';
          } else {
            feature.style.display = 'none';
          }
        });
      }
    }

    customElements.define('product-comparison-{{ ai_gen_id }}', ProductComparison{{ ai_gen_id }});
  })();
</script>

