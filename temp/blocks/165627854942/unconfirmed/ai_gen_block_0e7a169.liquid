{% doc %}
  @prompt
    A product banner was shop button and also a limited discount time visualizer that incentivize people to buy the product quicker, It seems to be layered behind the footer. It shows the photo content, so can you make it on top so that it doesn't interfere with the footer?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .ai-product-banner-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 40px;
    position: relative;
  }

  .ai-product-banner-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 300px;
    width: 300px;
  }

  .ai-product-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-banner-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-banner-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-product-banner-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-product-banner-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.2;
  }

  .ai-product-banner-description-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  .ai-product-banner-timer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: {{ block.settings.timer_background }};
    border-radius: {{ block.settings.timer_border_radius }}px;
    width: fit-content;
  }

  .ai-product-banner-timer-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.timer_label_size }}px;
    color: {{ block.settings.timer_text_color }};
    font-weight: 600;
  }

  .ai-product-banner-timer-units-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-product-banner-timer-unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .ai-product-banner-timer-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.timer_value_size }}px;
    font-weight: 700;
    color: {{ block.settings.timer_text_color }};
    min-width: 40px;
    text-align: center;
  }

  .ai-product-banner-timer-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.timer_unit_size }}px;
    color: {{ block.settings.timer_text_color }};
    opacity: 0.8;
    text-transform: uppercase;
  }

  .ai-product-banner-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: background 0.3s ease;
    width: fit-content;
  }

  .ai-product-banner-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-product-banner-container-{{ ai_gen_id }} {
      flex-direction: column;
      padding: 24px;
      gap: 24px;
    }

    .ai-product-banner-image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
      max-width: 300px;
    }

    .ai-product-banner-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-product-banner-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }

    .ai-product-banner-timer-{{ ai_gen_id }} {
      width: 100%;
      justify-content: center;
    }

    .ai-product-banner-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<product-banner-{{ ai_gen_id }}
  class="ai-product-banner-{{ ai_gen_id }}"
  data-end-date="{{ block.settings.end_date }}"
  data-end-time="{{ block.settings.end_time }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-banner-container-{{ ai_gen_id }}">
    <div class="ai-product-banner-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.product_image %}
        <img
          src="{{ block.settings.product_image | image_url: width: 600 }}"
          alt="{{ block.settings.product_image.alt | escape }}"
          class="ai-product-banner-image-{{ ai_gen_id }}"
          loading="lazy"
          width="600"
          height="600"
        >
      {% else %}
        <div class="ai-product-banner-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-product-banner-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-product-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-product-banner-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      <div class="ai-product-banner-timer-{{ ai_gen_id }}">
        <span class="ai-product-banner-timer-label-{{ ai_gen_id }}">{{ block.settings.timer_label }}</span>
        <div class="ai-product-banner-timer-units-{{ ai_gen_id }}">
          <div class="ai-product-banner-timer-unit-{{ ai_gen_id }}">
            <span class="ai-product-banner-timer-value-{{ ai_gen_id }}" data-days>00</span>
            <span class="ai-product-banner-timer-text-{{ ai_gen_id }}">Days</span>
          </div>
          <div class="ai-product-banner-timer-unit-{{ ai_gen_id }}">
            <span class="ai-product-banner-timer-value-{{ ai_gen_id }}" data-hours>00</span>
            <span class="ai-product-banner-timer-text-{{ ai_gen_id }}">Hours</span>
          </div>
          <div class="ai-product-banner-timer-unit-{{ ai_gen_id }}">
            <span class="ai-product-banner-timer-value-{{ ai_gen_id }}" data-minutes>00</span>
            <span class="ai-product-banner-timer-text-{{ ai_gen_id }}">Mins</span>
          </div>
          <div class="ai-product-banner-timer-unit-{{ ai_gen_id }}">
            <span class="ai-product-banner-timer-value-{{ ai_gen_id }}" data-seconds>00</span>
            <span class="ai-product-banner-timer-text-{{ ai_gen_id }}">Secs</span>
          </div>
        </div>
      </div>

      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-product-banner-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</product-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.endDate = this.dataset.endDate;
        this.endTime = this.dataset.endTime;
      }

      connectedCallback() {
        this.daysEl = this.querySelector('[data-days]');
        this.hoursEl = this.querySelector('[data-hours]');
        this.minutesEl = this.querySelector('[data-minutes]');
        this.secondsEl = this.querySelector('[data-seconds]');

        if (this.endDate && this.endTime) {
          this.startCountdown();
        }
      }

      startCountdown() {
        const targetDateTime = new Date(this.endDate + 'T' + this.endTime).getTime();

        const updateTimer = () => {
          const now = new Date().getTime();
          const distance = targetDateTime - now;

          if (distance < 0) {
            this.daysEl.textContent = '00';
            this.hoursEl.textContent = '00';
            this.minutesEl.textContent = '00';
            this.secondsEl.textContent = '00';
            return;
          }

          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          this.daysEl.textContent = String(days).padStart(2, '0');
          this.hoursEl.textContent = String(hours).padStart(2, '0');
          this.minutesEl.textContent = String(minutes).padStart(2, '0');
          this.secondsEl.textContent = String(seconds).padStart(2, '0');
        };

        updateTimer();
        this.interval = setInterval(updateTimer, 1000);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }
    }

    customElements.define('product-banner-{{ ai_gen_id }}', ProductBanner{{ ai_gen_id }});
  })();
</script>

