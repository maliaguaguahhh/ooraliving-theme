{% doc %}
  @prompt
    payment wall
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-payment-wall-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
  }

  .ai-payment-wall-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
  }

  .ai-payment-wall-icons-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
  }

  .ai-payment-wall-icon-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size | times: 0.6 }}px;
    padding: {{ block.settings.icon_padding }}px;
    background-color: {{ block.settings.icon_background }};
    border: {{ block.settings.icon_border_width }}px solid {{ block.settings.icon_border_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    transition: transform 0.2s ease;
  }

  .ai-payment-wall-icon-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-payment-wall-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-payment-wall-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-payment-wall-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.48 }}px;
    }
  }
{% endstyle %}

<div class="ai-payment-wall-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h3 class="ai-payment-wall-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
  {% endif %}

  <div class="ai-payment-wall-icons-{{ ai_gen_id }}">
    {% if block.settings.show_visa %}
      <div class="ai-payment-wall-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M19.8 23.4l2.4-14.8h3.8l-2.4 14.8h-3.8zm17.8-14.5c-.8-.3-2-.6-3.5-.6-3.8 0-6.5 2-6.5 4.9 0 2.1 1.9 3.3 3.4 4 1.5.7 2 1.2 2 1.8 0 1-.9 1.4-1.8 1.4-1.2 0-1.8-.2-2.8-.6l-.4-.2-.4 2.5c.9.4 2.6.8 4.3.8 4.1 0 6.7-2 6.7-5.1 0-1.7-1-3-3.2-4.1-1.3-.7-2.1-1.1-2.1-1.8 0-.6.7-1.2 2.2-1.2 1.3 0 2.2.3 2.9.5l.3.2.4-2.5zm6.3-.3h-2.9c-.9 0-1.6.3-2 1.1l-5.7 13.6h4.1l.8-2.2h5l.5 2.2h3.6l-3.1-14.7zm-4.8 9.5l2.1-5.7.1-.4 1.2 5.7h-3.4v.4zm-20.4-9.5l-3.7 10.1-.4-2c-.7-2.4-2.9-5-5.4-6.3l3.4 12.9h4.1l6.1-14.7h-4.1z"/>
          <path d="M8.9 8.6H2.1L2 9c4.9 1.2 8.1 4.2 9.4 7.8l-1.4-6.8c-.2-.8-.9-1.3-1.7-1.4z"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.show_mastercard %}
      <div class="ai-payment-wall-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
          <circle cx="18" cy="16" r="10" fill="#eb001b"/>
          <circle cx="30" cy="16" r="10" fill="#f79e1b"/>
          <path d="M24 8.8c-1.9 1.7-3 4.2-3 7.2s1.1 5.5 3 7.2c1.9-1.7 3-4.2 3-7.2s-1.1-5.5-3-7.2z" fill="#ff5f00"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.show_amex %}
      <div class="ai-payment-wall-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 4h40v24H4z" fill="#006fcf"/>
          <path d="M8 12h3.2l.8 2 .8-2h3.2v8h-2v-5l-1.2 3h-1.6l-1.2-3v5h-2v-8zm10 0h6v1.5h-4v1.5h4v1.5h-4v1.5h4V20h-6v-8zm8 0h2.5l1.5 2.5 1.5-2.5h2.5l-3 4 3 4h-2.5l-1.5-2.5-1.5 2.5h-2.5l3-4-3-4zm10 0h2l2 5 2-5h2l-3 8h-2l-3-8z" fill="#fff"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.show_discover %}
      <div class="ai-payment-wall-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 4h40v24H4z" fill="#fff"/>
          <path d="M4 4h40v12H4z" fill="#f47216"/>
          <circle cx="38" cy="16" r="8" fill="#f47216"/>
          <path d="M8 12h2v8h-2v-8zm4 0h3c2 0 3 1.5 3 4s-1 4-3 4h-3v-8zm2 1.5v5h1c1 0 1.5-.8 1.5-2.5s-.5-2.5-1.5-2.5h-1zm6-1.5h2v8h-2v-8zm4 0h4v1.5h-2v1.5h2v1.5h-2v1.5h2V20h-4v-8z" fill="#000"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.show_paypal %}
      <div class="ai-payment-wall-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M18.5 8h6.2c3.8 0 6 2 6 5.2 0 3.8-2.8 6.3-7 6.3h-2.4l-.8 4.5h-2.8l2.8-16zm3.8 9h1.8c2.2 0 3.5-1.2 3.5-3.2 0-1.5-.8-2.3-2.5-2.3h-1.8l-1 5.5zm-8.8-1h6.2c3.8 0 6 2 6 5.2 0 3.8-2.8 6.3-7 6.3h-2.4l-.8 4.5h-2.8l2.8-16zm3.8 9h1.8c2.2 0 3.5-1.2 3.5-3.2 0-1.5-.8-2.3-2.5-2.3h-1.8l-1 5.5z" fill="#003087"/>
          <path d="M18.5 8h6.2c3.8 0 6 2 6 5.2 0 3.8-2.8 6.3-7 6.3h-2.4l-.8 4.5h-2.8l2.8-16zm3.8 9h1.8c2.2 0 3.5-1.2 3.5-3.2 0-1.5-.8-2.3-2.5-2.3h-1.8l-1 5.5z" fill="#009cde"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.show_apple_pay %}
      <div class="ai-payment-wall-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M14.5 10.2c.5-.6 1.3-1.2 2.2-1.2.1 1-.3 1.9-.8 2.5-.5.6-1.3 1.1-2.1 1-.1-1 .3-1.9.7-2.3zm.7 1.3c-1.2-.1-2.2.7-2.8.7-.6 0-1.5-.6-2.5-.6-1.3 0-2.5.7-3.2 1.9-1.4 2.4-.4 5.9 1 7.8.7 1 1.5 2 2.6 2 1-.1 1.4-.6 2.6-.6 1.2 0 1.5.6 2.5.6 1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3 0 0-2.1-.8-2.1-3.2 0-2 1.6-3 1.7-3.1-1-1.4-2.5-1.6-3-1.6-.4.1-.9.2-1.4.4zm12.8 1.5c-2.5 0-4.5 2-4.5 4.5s2 4.5 4.5 4.5 4.5-2 4.5-4.5-2-4.5-4.5-4.5zm0 7.5c-1.7 0-3-1.3-3-3s1.3-3 3-3 3 1.3 3 3-1.3 3-3 3zm8-7.5c-1.2 0-2.2.5-2.8 1.3v-1.1h-1.5v10h1.5v-3.7c.6.8 1.6 1.3 2.8 1.3 2.2 0 3.8-1.8 3.8-4.4s-1.6-4.4-3.8-4.4zm-.3 7.5c-1.5 0-2.7-1.2-2.7-3s1.2-3 2.7-3 2.7 1.2 2.7 3-1.2 3-2.7 3z" fill="#000"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.show_google_pay %}
      <div class="ai-payment-wall-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.5 16.5v4h-1.5v-10h4c1 0 1.9.4 2.6 1.1.7.7 1.1 1.6 1.1 2.6s-.4 1.9-1.1 2.6c-.7.7-1.6 1.1-2.6 1.1h-2.5v-1.4zm0-5.5v4h2.5c.5 0 1-.2 1.4-.6.4-.4.6-.9.6-1.4s-.2-1-.6-1.4c-.4-.4-.9-.6-1.4-.6h-2.5zm11.5 2c1.2 0 2.2.4 3 1.2.8.8 1.2 1.8 1.2 3v4.3h-1.5v-1c-.6.8-1.5 1.2-2.7 1.2-1 0-1.8-.3-2.5-.9-.7-.6-1-1.3-1-2.2 0-.9.3-1.6 1-2.1.7-.5 1.6-.8 2.7-.8 1 0 1.8.2 2.5.5v-.3c0-.7-.3-1.3-.8-1.8-.5-.5-1.1-.7-1.8-.7-.9 0-1.7.4-2.3 1.1l-1-1c.9-1 2-1.5 3.2-1.5zm-2.2 6.3c0 .5.2.9.6 1.2.4.3.9.5 1.5.5.8 0 1.5-.3 2.1-.8.6-.5.9-1.2.9-1.9-.5-.4-1.3-.6-2.2-.6-.7 0-1.3.2-1.8.5-.5.3-.8.7-.8 1.1z" fill="#5f6368"/>
          <path d="M18 13l-4 9h1.5l1-2.5h4.5l1 2.5h1.5l-4-9h-1.5zm-.8 5.5l1.8-4.5 1.8 4.5h-3.6z" fill="#4285f4"/>
          <path d="M10 13v1.5h4.5c-.1.8-.5 1.5-1 2-.6.6-1.5 1.2-3 1.2-2.4 0-4.3-2-4.3-4.4s1.9-4.4 4.3-4.4c1.3 0 2.3.5 3 1.2l1.1-1.1c-1-1-2.4-1.6-4.1-1.6-3.3 0-6 2.7-6 6s2.7 6 6 6c1.8 0 3.1-.6 4.2-1.7 1.1-1.1 1.4-2.6 1.4-3.8 0-.4 0-.7-.1-1h-5.5z" fill="#ea4335"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.show_shop_pay %}
      <div class="ai-payment-wall-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 4h40v24H4z" fill="#5a31f4"/>
          <path d="M12 14c0-1.1.9-2 2-2h4c1.1 0 2 .9 2 2v4c0 1.1-.9 2-2 2h-4c-1.1 0-2-.9-2-2v-4zm8 0h-4v4h4v-4zm4 0c0-1.1.9-2 2-2h4c1.1 0 2 .9 2 2v4c0 1.1-.9 2-2 2h-4c-1.1 0-2-.9-2-2v-4zm8 0h-4v4h4v-4z" fill="#fff"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.show_venmo %}
      <div class="ai-payment-wall-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 4h40v24H4z" fill="#3d95ce"/>
          <path d="M18.5 10.5c.5 1 .8 2 .8 3.2 0 4.2-3.5 9.3-6.3 9.3h-3l-2-12.5h3.5l1.2 8.5c1.2-1.8 2.5-4.5 2.5-6.5 0-.8-.1-1.5-.3-2h3.6zm8.5 0c2.5 0 4 1.5 4 3.8 0 3.5-2.5 6.2-5.5 6.2-1.2 0-2-.5-2.5-1.2l-.5 3.2h-3l2-12h3l.2 1c.5-.8 1.5-1.5 2.8-1.5zm-.8 7.5c1 0 1.8-1.2 1.8-2.8 0-1-.5-1.5-1.2-1.5-.8 0-1.5.8-1.8 2.2l-.2 1.2c.2.5.8.9 1.4.9z" fill="#fff"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.show_klarna %}
      <div class="ai-payment-wall-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 4h40v24H4z" fill="#ffb3c7"/>
          <path d="M12 10h2v12h-2v-12zm6 0h2v5.5c1-1.5 2.5-2.5 4.5-2.5v2c-2.5 0-4.5 2-4.5 4.5v2.5h-2v-12zm10 3c2.5 0 4.5 2 4.5 4.5s-2 4.5-4.5 4.5-4.5-2-4.5-4.5 2-4.5 4.5-4.5zm0 7c1.4 0 2.5-1.1 2.5-2.5s-1.1-2.5-2.5-2.5-2.5 1.1-2.5 2.5 1.1 2.5 2.5 2.5z" fill="#000"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.show_afterpay %}
      <div class="ai-payment-wall-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 4h40v24H4z" fill="#b2fce4"/>
          <path d="M10 13h2l2 6 2-6h2l-3 9h-2l-3-9zm8 0h6v1.5h-4v1.5h4v1.5h-4v1.5h4V22h-6v-9zm8 0h2v7.5h4V22h-6v-9zm8 0h2v9h-2v-9z" fill="#000"/>
        </svg>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Payment wall",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We accept"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Payment methods"
    },
    {
      "type": "checkbox",
      "id": "show_visa",
      "label": "Show Visa",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mastercard",
      "label": "Show Mastercard",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_amex",
      "label": "Show American Express",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discover",
      "label": "Show Discover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_paypal",
      "label": "Show PayPal",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_apple_pay",
      "label": "Show Apple Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_google_pay",
      "label": "Show Google Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shop_pay",
      "label": "Show Shop Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_venmo",
      "label": "Show Venmo",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_klarna",
      "label": "Show Klarna",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_afterpay",
      "label": "Show Afterpay",
      "default": false
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Icon spacing",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "icon_padding",
      "label": "Icon padding",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "icon_border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "icon_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Container style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f6f6f6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1e1e1e"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Payment wall"
    }
  ]
}
{% endschema %}
