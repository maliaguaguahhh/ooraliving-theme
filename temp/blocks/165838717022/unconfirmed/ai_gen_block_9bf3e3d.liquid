<script>
  (function() {
    class HeroCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.container = this.querySelector('[data-carousel-container]');
        this.progressFill = this.querySelector('[data-progress-fill]');
        
        if (this.container && this.progressFill) {
          this.updateProgress();
          this.container.addEventListener('scroll', () => this.updateProgress());
        }
      }

      updateProgress() {
        const scrollLeft = this.container.scrollLeft;
        const scrollWidth = this.container.scrollWidth;
        const offsetWidth = this.container.offsetWidth;
        const maxScroll = scrollWidth - offsetWidth;
        
        if (maxScroll > 0) {
          const progress = (scrollLeft / maxScroll) * 100;
          this.progressFill.style.width = progress + '%';
        } else {
          this.progressFill.style.width = '0%';
        }
      }
    }

    customElements.define('hero-carousel-{{ ai_gen_id }}', HeroCarousel{{ ai_gen_id }});
  })();
</script>

