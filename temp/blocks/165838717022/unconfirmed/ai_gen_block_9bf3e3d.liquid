{% doc %}
  @prompt
    Create a new Shopify Liquid section called "Hero Carousel Swipe" — a full-screen horizontal swipe carousel using CSS scroll-snap and native touch scrolling only. No scroll-jacking, no wheel event overrides, no scroll-lock JavaScript.
    
    SLIDE LAYOUT:
    - Full viewport height (100vh) slides with full-bleed background image or video
    - Middle-left: body text in white, semi-transparent
    - Mid-left: rounded pill CTA button in muted dusty rose color (#B07878)
    - Bottom-left: very large bold white slide number + title (e.g. "3. Flow"), font size 80-100px
    - All text overlaid on top of the media
    
    HORIZONTAL SCROLL:
    - Container: display flex, flex-direction row, overflow-x scroll, overflow-y hidden
    - scroll-snap-type: x mandatory
    - scroll-snap-align: start on each slide
    - Hide scrollbar: scrollbar-width none + ::-webkit-scrollbar display none
    - -webkit-overflow-scrolling: touch
    - Each slide: flex 0 0 100%, width 100%, height 100vh
    
    PROGRESS INDICATOR:
    - Single thin pill progress bar (NOT dots), overlaid on media, bottom-center
    - Position: absolute, bottom 24px, horizontally centered
    - Track: 140px wide, 5px tall, border-radius 999px, background rgba(255,255,255,0.35)
    - Fill: grows left to right, color #B07878, smooth CSS transition
    - Updates via JS scroll event: fill width = scrollLeft / (scrollWidth - offsetWidth) * 100%
    - z-index above slides
    
    SCHEMA per slide block:
    - Background image picker
    - Optional video URL
    - Slide number + title text
    - Body text
    - Button label + link
    - Text color option (default white)
    
    Mobile-first, also works on desktop.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-carousel-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .ai-hero-carousel__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    overflow-x: scroll;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    height: 100%;
    width: 100%;
  }

  .ai-hero-carousel__container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-hero-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    width: 100%;
    height: 100vh;
    scroll-snap-align: start;
    position: relative;
    display: flex;
    align-items: center;
  }

  .ai-hero-carousel__media-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .ai-hero-carousel__video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .ai-hero-carousel__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    padding: 40px;
    max-width: 600px;
    margin-left: 5%;
  }

  .ai-hero-carousel__body-{{ ai_gen_id }} {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 24px;
    background-color: rgba(0, 0, 0, 0.3);
    padding: 16px 20px;
    border-radius: 8px;
  }

  .ai-hero-carousel__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: #B07878;
    color: #ffffff;
    text-decoration: none;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 500;
    transition: background-color 0.3s ease;
    margin-bottom: 40px;
  }

  .ai-hero-carousel__button-{{ ai_gen_id }}:hover {
    background-color: #9a6565;
  }

  .ai-hero-carousel__slide-title-{{ ai_gen_id }} {
    font-size: 100px;
    font-weight: 700;
    line-height: 1;
    margin: 0;
  }

  .ai-hero-carousel__progress-{{ ai_gen_id }} {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    width: 140px;
    height: 5px;
    background-color: rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    overflow: hidden;
  }

  .ai-hero-carousel__progress-fill-{{ ai_gen_id }} {
    height: 100%;
    background-color: #B07878;
    width: 0%;
    transition: width 0.1s ease-out;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-carousel__content-{{ ai_gen_id }} {
      padding: 24px;
      margin-left: 0;
    }

    .ai-hero-carousel__body-{{ ai_gen_id }} {
      font-size: 16px;
      padding: 12px 16px;
    }

    .ai-hero-carousel__button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 14px;
    }

    .ai-hero-carousel__slide-title-{{ ai_gen_id }} {
      font-size: 60px;
    }
  }
{% endstyle %}

<hero-carousel-{{ ai_gen_id }} class="ai-hero-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
